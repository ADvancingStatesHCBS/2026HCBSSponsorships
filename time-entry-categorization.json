        "jsonParameters": true,
        "options": {},
        "bodyParametersJson": "={\n  \"model\": \"gpt-3.5-turbo\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an expert categorization specialist. Your task is to receive a brief note and classify it into EXACTLY ONE of the predefined categories below.\\n\\nCRITICAL INSTRUCTIONS:\\n- You MUST choose EXACTLY ONE category from the list below\\n- Return the category name EXACTLY as written - no variations, abbreviations, or modifications\\n- Do not add numbers, prefixes, or any other text to the category name\\n- If the note is unclear or empty, use 'No Comments / Not Specified'\\n- Conference names (like NASDDDS, SNP Alliance, Milken, MLTSS Summit, etc.) should be categorized as 'Travel and Events'\\n- Meeting with specific organizations or people should be 'Meetings and Collaboration'\\n- Research, reading reports, or policy work should be 'Policy and Research'\\n- Calls with directors or policy updates should be 'Meetings and Collaboration'\\n- Webinars attended or presented should be 'Training, Webinars, and Presentations'\\n- Office hours with states should be 'Technical Assistance to States'\\n\\nVALID CATEGORIES (copy exactly):\\nMeetings and Collaboration\\nProject Work and Deliverables\\nAdministrative and Operational Tasks\\nFinancial and Invoicing\\nTraining, Webinars, and Presentations\\nTravel and Events\\nTechnical Assistance to States\\nCommunications and Outreach\\nPolicy and Research\\nNo Comments / Not Specified\\n\\nReturn ONLY valid JSON in this exact format:\\n{\\n  \\\"category\\\": \\\"<exact category name from list above>\\\",\\n  \\\"hours\\\": <hours_value>\\n}\\n\\nDO NOT include any explanations, markdown formatting, or additional text. Return only the JSON object.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Note: {{ $json.notes_original }}\\n\\nStates mentioned (if any): {{ $json.states }}\\n\\nHours of activity: {{ $json.Hours }}\"\n    }\n  ],\n  \"temperature\": 0.3,\n  \"response_format\": { \"type\": \"json_object\" }\n}"
      },
